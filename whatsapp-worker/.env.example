# Copy this file to .env and fill in real values. Never commit .env.

# Host/port the worker listens on. Keep this 127.0.0.1 — the worker must
# never be reachable from outside this machine.
HOST=127.0.0.1
PORT=3001

# Shared secret with the Laravel backend (backend/.env must have the same
# value under the same name). Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Laravel's internal webhook, for QR/connection-state callbacks.
LARAVEL_CALLBACK_URL=http://127.0.0.1:8000/internal/worker/events

# Where Baileys auth files are stored, one folder per instance_id. Must
# stay outside the repo and outside C:\xampp\htdocs — Apache serves
# htdocs, so anything under it could become web-reachable.
SESSION_STORAGE_PATH=C:\whatsapp-secrets
