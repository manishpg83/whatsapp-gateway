{
  "name": "whatsapp-worker",
  "version": "1.0.0",
  "description": "Node.js/TypeScript worker that talks to WhatsApp via Baileys, on behalf of the Laravel backend.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
